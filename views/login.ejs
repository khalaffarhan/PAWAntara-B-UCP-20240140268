<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="section auth-section">
      <div class="container auth-container fade-up">
        <div class="auth-card">
          <div class="auth-icon"><i class="bi bi-shield-lock-fill"></i></div>
          <h1>Login Admin / Kasir</h1>
          <p class="auth-desc">
            Khusus untuk Ibu Aries &amp; kasir toko — masuk untuk mengelola
            data produk lewat dashboard.
          </p>

          <div id="loginAlert" class="auth-alert" role="alert" hidden></div>

          <form id="loginForm" class="auth-form" novalidate>
            <div class="form-group">
              <label for="username">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                placeholder="Masukkan username"
                autocomplete="username"
                required
              />
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <div class="password-field">
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Masukkan password"
                  autocomplete="current-password"
                  required
                />
                <button type="button" id="togglePassword" class="toggle-password" aria-label="Tampilkan password">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" id="loginSubmitBtn">
              <i class="bi bi-box-arrow-in-right"></i> Masuk
            </button>
          </form>

          <a href="/" class="back-link">
            <i class="bi bi-arrow-left"></i> Kembali ke Beranda
          </a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script src="/js/login.js"></script>
</body>
</html>
