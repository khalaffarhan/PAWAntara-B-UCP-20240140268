<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-header">
      <div class="container fade-up">
        <span class="eyebrow"><i class="bi bi-basket3-fill"></i> Katalog</span>
        <h1>Semua Produk Sembako</h1>
        <p>Cari kebutuhan dapur Anda, harga &amp; stok selalu diperbarui.</p>
      </div>
    </section>

    <section class="section produk-section">
      <div class="container">
        <!-- Filter & search (diproses client-side lewat Fetch API ke GET /api/products) -->
        <form class="filter-bar fade-up" id="filterForm">
          <div class="search-box">
            <i class="bi bi-search"></i>
            <input
              type="search"
              name="search"
              id="searchInput"
              placeholder="Cari produk, mis. beras, minyak..."
              aria-label="Cari produk"
            />
          </div>
          <button type="submit" class="btn btn-primary">Cari</button>
        </form>

        <div class="category-pills fade-up" id="categoryPills">
          <a href="#" data-kategori="semua" class="pill active">Semua</a>
          <% categories.forEach(function(c) { %>
            <a href="#" data-kategori="<%= c %>" class="pill"><%= c %></a>
          <% }); %>
        </div>

        <!-- Hasil (diisi dinamis oleh public/js/produk.js) -->
        <p class="result-count fade-up" id="resultCount">Memuat produk...</p>

        <div class="product-grid" id="productGrid">
          <p class="table-loading"><i class="bi bi-arrow-repeat"></i> Memuat data produk dari server...</p>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script src="/js/produk.js"></script>
</body>
</html>
