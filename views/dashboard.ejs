<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-header page-header-compact">
      <div class="container fade-up">
        <span class="eyebrow"><i class="bi bi-speedometer2"></i> Panel Admin</span>
        <h1>Dashboard Produk</h1>
        <p>Halo, <strong><%= adminUsername %></strong> — kelola produk toko dari sini.</p>
      </div>
    </section>

    <section class="section dashboard-section">
      <div class="container">
        <!-- Form tambah/edit produk -->
        <div class="dashboard-card fade-up">
          <h2 id="formTitle"><i class="bi bi-plus-circle-fill"></i> Tambah Produk</h2>

          <div id="formAlert" class="auth-alert" role="alert" hidden></div>

          <form id="productForm" class="product-form" novalidate>
            <input type="hidden" id="productId" name="id" />

            <div class="form-grid">
              <div class="form-group">
                <label for="name">Nama Produk</label>
                <input type="text" id="name" name="name" placeholder="Contoh: Beras 5kg" required />
              </div>

              <div class="form-group">
                <label for="category">Kategori</label>
                <input type="text" id="category" name="category" placeholder="Contoh: Beras" required />
              </div>

              <div class="form-group">
                <label for="price">Harga (Rp)</label>
                <input type="number" id="price" name="price" min="0" step="500" placeholder="65000" required />
              </div>

              <div class="form-group">
                <label for="stock">Stok</label>
                <input type="number" id="stock" name="stock" min="0" step="1" placeholder="20" required />
              </div>

              <div class="form-group">
                <label for="unit">Satuan / Kemasan</label>
                <input type="text" id="unit" name="unit" placeholder="Contoh: 5 kg" />
              </div>

              <div class="form-group">
                <label for="icon">Ikon (Bootstrap Icons, opsional)</label>
                <input type="text" id="icon" name="icon" placeholder="bi-basket2-fill" />
              </div>
            </div>

            <div class="form-group">
              <label for="description">Deskripsi</label>
              <textarea id="description" name="description" rows="3" placeholder="Deskripsi singkat produk..."></textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="submitBtn">
                <i class="bi bi-check-circle-fill"></i> Simpan Produk
              </button>
              <button type="button" class="btn btn-outline" id="cancelEditBtn" hidden>
                <i class="bi bi-x-circle"></i> Batal Edit
              </button>
            </div>
          </form>
        </div>

        <!-- Tabel produk -->
        <div class="dashboard-card fade-up">
          <h2><i class="bi bi-list-ul"></i> Daftar Produk</h2>

          <div class="table-wrapper">
            <table class="product-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nama</th>
                  <th>Kategori</th>
                  <th>Harga</th>
                  <th>Stok</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody id="productTableBody">
                <tr>
                  <td colspan="6" class="table-loading">
                    <i class="bi bi-arrow-repeat"></i> Memuat data produk...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
